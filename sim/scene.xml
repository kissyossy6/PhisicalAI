<mujoco model="tidy-up table">
  <include file="../third_party/mujoco_menagerie/franka_emika_panda/panda.xml"/>
  <compiler meshdir="../third_party/mujoco_menagerie/franka_emika_panda/assets"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.85 0.88 0.92" rgb2="0.55 0.6 0.68" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" rgb1="0.42 0.44 0.47" rgb2="0.38 0.4 0.43" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="6 6"/>
    <material name="wood" rgba="0.72 0.58 0.42 1" specular="0.05"/>
  </asset>

  <default>
    <default class="item">
      <geom condim="4" friction="1.5 0.02 0.002" solref="0.005 1" solimp="0.95 0.99 0.001" priority="1"/>
    </default>
    <default class="fruit">
      <geom condim="6" friction="1.5 0.02 0.004" solref="0.005 1" solimp="0.95 0.99 0.001" priority="1"/>
    </default>
    <default class="wall">
      <geom type="box" condim="3" friction="0.8 0.01 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 -0.4 1.6" dir="-0.2 0.3 -1" directional="true" castshadow="true" diffuse="0.45 0.45 0.45"/>
    <geom name="floor" type="plane" pos="0 0 -0.75" size="0 0 0.05" material="floor"/>
    <geom name="table" type="box" pos="0.35 0 -0.025" size="0.6 0.7 0.025" material="wood"/>

    <!-- Camera that Gemini sees: oblique, from the front of the table -->
    <camera name="gemini" pos="0.98 0 0.82" xyaxes="0 1 0 -0.840 0 0.543" fovy="58"/>
    <!-- Cinematic camera for the video -->
    <camera name="cinema" pos="1.0 -0.75 0.6" xyaxes="0.791 0.612 0 -0.327 0.423 0.845" fovy="50"/>

    <!-- Fruit plate (round) -->
    <body name="plate" pos="0.45 -0.38 0">
      <geom type="cylinder" size="0.11 0.004" pos="0 0 0.004" rgba="0.95 0.95 0.93 1"/>
      <geom type="cylinder" size="0.115 0.006" pos="0 0 0.006" rgba="0.3 0.55 0.85 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.1 0.0065" pos="0 0 0.0065" rgba="0.97 0.97 0.95 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Toy box (open tray with walls) -->
    <body name="toybox" pos="0.45 0.38 0">
      <geom class="wall" size="0.11 0.11 0.004" pos="0 0 0.004" rgba="0.85 0.35 0.2 1"/>
      <geom class="wall" size="0.11 0.006 0.03" pos="0 0.104 0.03" rgba="0.85 0.35 0.2 1"/>
      <geom class="wall" size="0.11 0.006 0.03" pos="0 -0.104 0.03" rgba="0.85 0.35 0.2 1"/>
      <geom class="wall" size="0.006 0.11 0.03" pos="0.104 0 0.03" rgba="0.85 0.35 0.2 1"/>
      <geom class="wall" size="0.006 0.11 0.03" pos="-0.104 0 0.03" rgba="0.85 0.35 0.2 1"/>
    </body>

    <!-- Items scattered on the table -->
    <body name="apple" pos="0.55 -0.08 0.03">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.08" diaginertia="2.51e-05 2.51e-05 2.51e-05"/>
      <geom class="fruit" type="sphere" size="0.028" rgba="0.8 0.08 0.1 1" mass="0.08"/>
      <geom type="cylinder" size="0.003 0.008" pos="0 0 0.033" rgba="0.35 0.2 0.08 1" contype="0" conaffinity="0" mass="0.001"/>
      <geom type="ellipsoid" size="0.012 0.005 0.002" pos="0.01 0 0.036" euler="0 0.4 0" rgba="0.2 0.6 0.15 1" contype="0" conaffinity="0" mass="0.001"/>
    </body>
    <body name="orange" pos="0.35 0.1 0.03">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.08" diaginertia="2.69e-05 2.69e-05 2.69e-05"/>
      <geom class="fruit" type="sphere" size="0.029" rgba="1.0 0.5 0.05 1" mass="0.08"/>
      <geom type="sphere" size="0.004" pos="0 0 0.028" rgba="0.3 0.45 0.1 1" contype="0" conaffinity="0" mass="0.001"/>
    </body>
    <body name="lemon" pos="0.62 0.15 0.025">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.06" diaginertia="1.62e-05 1.62e-05 1.62e-05"/>
      <geom class="fruit" type="ellipsoid" size="0.034 0.024 0.024" rgba="0.98 0.88 0.15 1" mass="0.06"/>
    </body>
    <body name="red_block" pos="0.3 -0.15 0.022">
      <freejoint/>
      <geom class="item" type="box" size="0.022 0.022 0.022" rgba="0.9 0.15 0.15 1" mass="0.05"/>
    </body>
    <body name="blue_block" pos="0.48 0.05 0.022">
      <freejoint/>
      <geom class="item" type="box" size="0.022 0.022 0.022" rgba="0.15 0.35 0.9 1" mass="0.05"/>
    </body>
    <body name="green_block" pos="0.65 -0.2 0.022">
      <freejoint/>
      <geom class="item" type="box" size="0.022 0.022 0.022" rgba="0.15 0.7 0.25 1" mass="0.05"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="ready" qpos="0 -0.3 0 -2.2 0 1.9 0.785 0.04 0.04
                            0.55 -0.08 0.03 1 0 0 0
                            0.35 0.1 0.03 1 0 0 0
                            0.62 0.15 0.025 1 0 0 0
                            0.3 -0.15 0.022 1 0 0 0
                            0.48 0.05 0.022 1 0 0 0
                            0.65 -0.2 0.022 1 0 0 0"
         ctrl="0 -0.3 0 -2.2 0 1.9 0.785 255"/>
  </keyframe>
</mujoco>
